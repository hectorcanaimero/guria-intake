ROUTER_BASE_URL=https://your-router.example.com/v1
ROUTER_API_KEY=
ROUTER_MODEL=guria-intake
# Solo en desarrollo: las trazas quedan fuera del flujo de borrado (LGPD).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=guria-intake
TYPESAFE_API_KEY=
REPORTE_WEBHOOK_URL=
# Aviso de cada intake por email, con el documento interno y la propuesta adjuntos
# Resend por SMTP: el usuario es literalmente "resend" y la clave es la API key (re_...)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Guria Intake <intake@guria.lat>
AVISOS_EMAIL=
XAPI=
# Link para agendar la reunión online (aparece en la última slide de la propuesta)
AGENDA_URL=
# Opcional: ruta a Chromium/headless shell para generar el PDF
CHROMIUM_BIN=

# Estimación interna: horas del modelo × tarifa (USD/h, freelance senior para clientes LATAM)
TARIFA_USD_HORA=25-45
HORAS_SEMANA=25
